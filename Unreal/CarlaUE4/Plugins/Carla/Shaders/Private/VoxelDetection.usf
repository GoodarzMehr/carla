#include "/Engine/Public/Platform.ush"

// These layouts match VoxelDetectionGPU.h exactly, including uint metadata.
struct FVoxelChunk
{
    float4 OriginAndError;
    float4 StepX;
    float4 StepY;
    float4 StepZ;
    uint4 SizeAndOutput;
    uint4 Candidates;
};

struct FVoxelCandidate
{
    uint TriangleOffset;
    uint TriangleCount;
    uint Label;
    uint Priority;
};

struct FVoxelTriangle
{
    uint AxisOffset;
    uint NumAxes;
    uint Degenerate;
    uint Padding;
};

struct FVoxelAxis
{
    float4 DirectionAndMin;
    float4 MaxAndError;
};

StructuredBuffer<FVoxelChunk> Chunks;
StructuredBuffer<FVoxelCandidate> Candidates;
StructuredBuffer<FVoxelTriangle> Triangles;
StructuredBuffer<FVoxelAxis> Axes;
RWTexture2D<uint> OutputWords;
uint ChunkCount;
uint DispatchWidth;
uint OutputWidth;

// UE4's Vulkan HLSLcc can lower isfinite to !isinf, which accepts NaNs.
bool FiniteFloat(float Value)
{
    return (asuint(Value) & 0x7f800000u) != 0x7f800000u;
}

bool FiniteFloat3(float3 Value)
{
    return all((asuint(Value) & 0x7f800000u) != 0x7f800000u);
}

bool FiniteFloat4(float4 Value)
{
    return all((asuint(Value) & 0x7f800000u) != 0x7f800000u);
}

// 0 outside, 1 definite overlap, 2 uncertain: the CPU resolves uncertain results.
uint TestTriangle(FVoxelTriangle Triangle, float3 Center, float CenterError)
{
    if (Triangle.Degenerate != 0 || Triangle.NumAxes == 0)
    {
        return 2;
    }
    bool Uncertain = false;
    for (uint Index = 0; Index < Triangle.NumAxes; ++Index)
    {
        FVoxelAxis Axis = Axes[Triangle.AxisOffset + Index];
        float3 Direction = Axis.DirectionAndMin.xyz;
        float Minimum = Axis.DirectionAndMin.w;
        float Maximum = Axis.MaxAndError.x;
        float CPUError = Axis.MaxAndError.y;
        float Projection = dot(Direction, Center);
        float PositionError = CenterError * max(1.0, dot(abs(Direction), float3(1.0, 1.0, 1.0)));
        float Error = CPUError + PositionError + 16.0 * 1.1920928955078125e-7 *
            (dot(abs(Direction), abs(Center)) + max(abs(Minimum), abs(Maximum)) +
             CPUError + PositionError);
        if (!FiniteFloat4(Axis.DirectionAndMin) || !FiniteFloat4(Axis.MaxAndError) ||
            !FiniteFloat(Projection) || !FiniteFloat(Error) || CPUError < 0.0 || Minimum > Maximum)
        {
            return 2;
        }
        if (Projection < Minimum - Error || Projection > Maximum + Error)
        {
            return 0;
        }
        if (Projection <= Minimum + Error || Projection >= Maximum - Error)
        {
            Uncertain = true;
        }
    }
    return Uncertain ? 2 : 1;
}

uint QueryVoxel(FVoxelChunk Chunk, uint Index)
{
    uint3 Size = Chunk.SizeAndOutput.xyz;
    uint X = Index / (Size.y * Size.z);
    uint Remainder = Index % (Size.y * Size.z);
    uint Y = Remainder / Size.z;
    uint Z = Remainder % Size.z;
    float3 Center = Chunk.OriginAndError.xyz + float(X) * Chunk.StepX.xyz +
        float(Y) * Chunk.StepY.xyz + float(Z) * Chunk.StepZ.xyz;
    float CenterError = Chunk.OriginAndError.w;
    if (!FiniteFloat3(Center) || !FiniteFloat(CenterError) || CenterError < 0.0)
    {
        return 255;
    }
    uint Label = 0;
    uint Priority = 0;
    for (uint CandidateIndex = 0; CandidateIndex < Chunk.Candidates.y; ++CandidateIndex)
    {
        FVoxelCandidate Candidate = Candidates[Chunk.Candidates.x + CandidateIndex];
        if (Candidate.Priority < Priority)
        {
            break;
        }
        if (Candidate.Label == Label)
        {
            continue;
        }
        bool Overlap = false;
        bool Uncertain = false;
        for (uint TriangleIndex = 0; TriangleIndex < Candidate.TriangleCount; ++TriangleIndex)
        {
            uint Result = TestTriangle(Triangles[Candidate.TriangleOffset + TriangleIndex],
                Center, CenterError);
            if (Result == 1)
            {
                Overlap = true;
                break;
            }
            Uncertain = Uncertain || Result == 2;
        }
        if (Overlap)
        {
            if (Label != 0 && Candidate.Label != Label)
            {
                return 255;
            }
            Label = Candidate.Label;
            Priority = Candidate.Priority;
        }
        else if (Uncertain)
        {
            return 255;
        }
    }
    return Label;
}

[numthreads(128, 1, 1)]
void MainCS(uint3 Group : SV_GroupID, uint3 Thread : SV_GroupThreadID)
{
    uint ChunkIndex = Group.x + Group.y * DispatchWidth;
    if (ChunkIndex >= ChunkCount)
    {
        return;
    }
    FVoxelChunk Chunk = Chunks[ChunkIndex];
    uint NumVoxels = Chunk.SizeAndOutput.x * Chunk.SizeAndOutput.y * Chunk.SizeAndOutput.z;
    uint NumWords = (NumVoxels + 3) / 4;
    for (uint Word = Thread.x; Word < NumWords; Word += 128)
    {
        uint Packed = 0;
        for (uint Lane = 0; Lane < 4; ++Lane)
        {
            uint Voxel = Word * 4 + Lane;
            uint Label = Voxel < NumVoxels ? QueryVoxel(Chunk, Voxel) : 0;
            Packed |= Label << (Lane * 8);
        }
        uint OutputIndex = Chunk.SizeAndOutput.w + Word;
        OutputWords[uint2(OutputIndex % OutputWidth, OutputIndex / OutputWidth)] = Packed;
    }
}
